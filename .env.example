# =============================================================================
# Travel Agent AI Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY (Bug 5 Fix - CRITICAL)
# -----------------------------------------------------------------------------
# JWT secret key - REQUIRED in production! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS allowed origins (comma-separated) - Bug 5 Fix: Restrict to specific domains
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://127.0.0.1:3000

# Guest user for anonymous trip planning
GUEST_USER_EMAIL=guest@travel-agent.local
GUEST_USER_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL password for travel_admin user
DB_PASSWORD=travel_secure_2026

# Full database URL (auto-constructed in docker-compose, override if needed)
# DATABASE_URL=postgresql+asyncpg://travel_admin:travel_secure_2026@postgres:5432/travel_agent

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# AI / LLM (Bug 7 Fix - CRITICAL)
# -----------------------------------------------------------------------------
# OpenAI API key - get from https://platform.openai.com/api-keys
# REQUIRED for AI features to work properly
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use for trip planning (gpt-4o recommended, gpt-3.5-turbo for cost savings)
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens per AI response
OPENAI_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# GOOGLE SERVICES
# -----------------------------------------------------------------------------
# Google Places API key - get from https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=AIza...

# Google Maps Embed API key (can be same as above)
GOOGLE_MAPS_API_KEY=AIza...

# -----------------------------------------------------------------------------
# TRAVEL TOOL MODE
# -----------------------------------------------------------------------------
# MOCK  - Use simulated data (for development, no external API calls)
# LIVE  - Use real external APIs (requires all API keys above)
TRAVEL_TOOL_MODE=MOCK

# -----------------------------------------------------------------------------
# FLIGHT SEARCH (optional - for LIVE mode)
# -----------------------------------------------------------------------------
# Amadeus API credentials - get from https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Skyscanner API key (RapidAPI) - https://rapidapi.com/skyscanner/
SKYSCANNER_API_KEY=

# -----------------------------------------------------------------------------
# HOTEL SEARCH (optional - for LIVE mode)
# -----------------------------------------------------------------------------
# Booking.com API (via RapidAPI)
BOOKING_API_KEY=

# Hotels.com API (via RapidAPI)
HOTELS_API_KEY=

# -----------------------------------------------------------------------------
# CURRENCY
# -----------------------------------------------------------------------------
# ExchangeRate-API key - get from https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# Open Exchange Rates - https://openexchangerates.org/
OPEN_EXCHANGE_RATES_APP_ID=

# Base currency for default display
DEFAULT_CURRENCY=VND

# -----------------------------------------------------------------------------
# TRANSLATION (optional - for LIVE mode)
# -----------------------------------------------------------------------------
# DeepL API key - https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Google Translate API key
GOOGLE_TRANSLATE_API_KEY=

# -----------------------------------------------------------------------------
# FRONTEND (Next.js)
# -----------------------------------------------------------------------------
# Backend API base URL accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps embed key for Leaflet / Maps components
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# App name (shown in UI)
NEXT_PUBLIC_APP_NAME=Travel Agent AI

# Default language for the UI (vi, en, ko, ja, zh, fr, es, de, th)
NEXT_PUBLIC_DEFAULT_LANGUAGE=vi

# Default currency
NEXT_PUBLIC_DEFAULT_CURRENCY=VND

# -----------------------------------------------------------------------------
# LOGGING & MONITORING (optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Sentry DSN for error tracking - https://sentry.io/
SENTRY_DSN=

# -----------------------------------------------------------------------------
# EMAIL (optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@travelagent.ai

# -----------------------------------------------------------------------------
# STORAGE (optional - for PDF exports and user uploads)
# -----------------------------------------------------------------------------
# Local storage path (relative to backend /app)
STORAGE_PATH=./storage

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-1
